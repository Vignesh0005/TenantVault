{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=tenantvault;Username=tenantvault_app;Password=app_pw"
  },
  "Jwt": {
    "Issuer": "tenantvault-api",
    "Audience": "tenantvault-web",
    "ExpiryMinutes": 30
  },
  "S3": {
    "ServiceUrl": "http://localstack:4566",
    "PublicServiceUrl": "http://localhost:4566",
    "BucketName": "tenantvault",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test",
    "ForcePathStyle": true
  },
  "Tenancy": {
    "BaseDomain": "localhost"
  },
  "Inventory": {
    "LowStockThreshold": 10,
    "DeadStockDays": 30
  },
  "RateLimiting": {
    "AuthPerMinute": 10,
    "SimulatorPerMinute": 10,
    "GlobalPerMinute": 300
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Seed": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
